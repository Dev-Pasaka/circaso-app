<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark, inset so it stays inside the circle the system masks the splash icon to.
  This one is a 1024 px bitmap on purpose: the system rasterises a vector (especially one with gradients) at a low
  resolution for the splash and scales it up, which looks blurry. A bitmap larger than the target stays sharp.
  Everywhere else in the app the mark is a vector.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_mark"
    android:inset="17%" />
