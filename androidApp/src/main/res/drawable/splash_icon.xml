<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch splash icon. It is an animated-vector with nothing to animate, on purpose:
  Android 12+ draws a still splash icon by first rendering it into a 108 dp bitmap and then stretching that bitmap to
  192 dp (SplashscreenIconDrawableFactory.ImmobileIconDrawable), which is blurry whatever the source resolution.
  An Animatable icon skips that bitmap and is drawn live at full size, so the mark stays sharp.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_mark_vector" />
