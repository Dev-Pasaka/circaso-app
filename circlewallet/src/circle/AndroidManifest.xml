<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle's SDK declares Facebook login in its manifest. Circaso doesn't use Circle's social login and doesn't ship the
  Facebook SDK, so its activities and keys are removed from the merged manifest here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <meta-data android:name="com.facebook.sdk.ApplicationId" tools:node="remove" />
        <meta-data android:name="com.facebook.sdk.ClientToken" tools:node="remove" />
        <activity android:name="com.facebook.FacebookActivity" tools:node="remove" />
        <activity android:name="com.facebook.CustomTabActivity" tools:node="remove" />
        <!-- Circle's screens are AppCompat activities with no theme of their own: give them Circaso's. -->
        <activity android:name="circle.programmablewallet.sdk.internal.presentation.ui.PWalletAppActivity" android:theme="@style/Theme.Circaso.CircleWallet" />
    </application>
</manifest>
